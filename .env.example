# Template only - copy this to .env and fill in real values for LOCAL
# TESTING (e.g. `docker run --env-file .env ...`). The real .env is
# gitignored (see .gitignore) and must never be committed - only this
# .example file, with placeholders, belongs in the repo.
#
# ASP.NET Core does NOT auto-load .env files the way Node's dotenv does -
# these are for you to pass explicitly (docker --env-file, or your shell),
# or to copy into Render's dashboard / render.yaml's sync:false prompts.
# For everyday local development without Docker, `dotnet user-secrets` is
# the better fit - see the root README's "Configure backend secrets" step.

# Either set this directly in Npgsql/ADO.NET format...
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=fhsms;Username=fhsms_user;Password=change_me
# ...or, if you're pointing at a host that only gives you a postgres:// URI
# (like Render's managed Postgres), set DATABASE_URL instead - Program.cs
# converts it automatically and it takes precedence over the line above.
# DATABASE_URL=postgres://fhsms_user:change_me@localhost:5432/fhsms

# Generate your own - at least 32 random characters. Never reuse this
# placeholder anywhere real.
Jwt__Secret=REPLACE_THIS_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
Jwt__Issuer=FHSMS.API
Jwt__Audience=FHSMS.Clients
Jwt__ExpiryMinutes=480

# Comma-separated list of frontend origins allowed to call this API.
# Leave unset locally - falls back to allowing any origin.
ALLOWED_ORIGINS=http://localhost:5173

# Needed for Chapa's initiate-payment call (callback_url/return_url) - see
# PaymentProviderSettings. Not needed for BankTransfer/Telebirr/CbeBirr yet.
PaymentProviders__ApiPublicBaseUrl=http://localhost:5080
PaymentProviders__FrontendPublicBaseUrl=http://localhost:5173

# Only needed once you wire up real payment webhooks.
PaymentProviders__BankTransfer__Secret=
PaymentProviders__Telebirr__Secret=
PaymentProviders__Chapa__Secret=
PaymentProviders__CbeBirr__Secret=

# Render sets this automatically - don't set it yourself locally unless
# you're deliberately testing the container's PORT-reading behavior.
# PORT=8080
